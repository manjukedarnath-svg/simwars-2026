            <label><input type="checkbox" /> PALS</label>
            <label><input type="checkbox" /> NLS / NRP</label>
            <label><input type="checkbox" /> Other: <input type="text" style="width:auto;display:inline;padding:4px 8px;border-radius:6px;" placeholder="specify" /></label>
        </div>
    </div>

    <!-- SECTION 2 – ROLE‑SPECIFIC EXPERIENCE -->
    <div class="section-title">2. Role‑Specific Clinical Experience <span class="optional">(complete your role below)</span></div>

    <!-- 2A – Nurse -->
    <div id="roleSection2A" class="role-section">
        <div class="role-banner">🧑‍⚕️ For Nurses (Registered, Staff, Charge, Educator)</div>
        <div class="form-group">
            <label>2A.1 Which tasks do you regularly perform? <span class="optional">(select all that apply)</span></label>
            <div class="checkbox-group">
                <label><input type="checkbox" /> Airway assessment &amp; basic manoeuvres</label>
