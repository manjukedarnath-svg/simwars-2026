<div class="container" id="app">

    <!-- HEADER -->
    <h1>⚕️ SimWars 2026 – Pre‑Event Questionnaire</h1>
    <div class="subhead">
        Participant Baseline Assessment &bull; Two parts &bull; ~12 min
    </div>

    <!-- PRIVACY NOTE -->
    <div class="note-privacy">
        <strong>🔒 Confidential</strong> – Your responses are seen only by the organising team (not judges).
        Sensitive questions (anxiety, support needs) are for your comfort and safety.
    </div>

    <!-- ============================================================ -->
    <!-- PART 1 – SIMWARS AWARENESS                                     -->
    <!-- ============================================================ -->

    <div class="part-divider">Part 1 <small>Competition Awareness &amp; Readiness</small></div>

    <!-- Comparison table -->
    <div class="comparison-table">
        <table>
            <thead><tr><th>Aspect</th><th>Standard Simulation</th><th>SimWars 2026</th></tr></thead>
            <tbody>
                <tr><td>Primary Purpose</td><td>Learning – practice, make mistakes</td><td>Assessment &amp; competition – perform under pressure</td></tr>
                <tr><td>Stakes</td><td>Low – mistakes welcomed</td><td>High – mistakes penalised</td></tr>
                <tr><td>Audience</td><td>Closed</td><td>Public – live audience, projected video</td></tr>
                <tr><td>Debriefing</td><td>In-depth, confidential, balanced</td><td>Public positive-only + private written feedback</td></tr>
                <tr><td>Judging</td><td>Informal developmental feedback</td><td>Structured scoring by expert judges (rubrics)</td></tr>
                <tr><td>Resources</td><td>Unlimited time, no constraints</td><td>15‑min hard stop, explicit resource decisions</td></tr>
                <tr><td>Manikin</td><td>Guidance / prompting allowed</td><td>No prompting – <strong>you must DO</strong> (don't just ask)</td></tr>
            </tbody>
        </table>
    </div>

    <!-- SECTION A -->
    <div class="section-title">A. Rules &amp; Format Knowledge</div>

    <div class="form-group">
        <label>A1. Have you read the official SimWars 2026 Participant Information Pack?</label>
        <select>
            <option value="">– Please select –</option>
            <option>Yes, thoroughly</option>
            <option>Yes, briefly skimmed</option>
            <option>No, not yet</option>
        </select>
    </div>

    <div class="form-group">
        <label>A2. Please indicate your understanding of the following rules:</label>
        <div style="overflow-x:auto; margin-top:6px;">
            <table style="width:100%; border-collapse:collapse; background:#f9fafc; border-radius:12px; font-size:14px;">
                <thead><tr style="background:#e2e8f0;">
                    <th style="padding:8px 10px; text-align:left;">Statement</th>
                    <th style="padding:8px 6px; text-align:center; width:80px;">Yes</th>
                    <th style="padding:8px 6px; text-align:center; width:80px;">No</th>
                    <th style="padding:8px 6px; text-align:center; width:80px;">Unsure</th>
                </tr></thead>
                <tbody>
                    <tr><td style="padding:6px 10px;">15‑minute hard stop – pens down at whistle</td>
                        <td style="text-align:center;"><input type="radio" name="r1" value="yes" /></td>
                        <td style="text-align:center;"><input type="radio" name="r1" value="no" /></td>
                        <td style="text-align:center;"><input type="radio" name="r1" value="unsure" /></td>
                    </tr>
                    <tr><td style="padding:6px 10px;">Stage 5 penalty (–10) for entering a predefined rescue state</td>
                        <td style="text-align:center;"><input type="radio" name="r2" value="yes" /></td>
                        <td style="text-align:center;"><input type="radio" name="r2" value="no" /></td>
                        <td style="text-align:center;"><input type="radio" name="r2" value="unsure" /></td>
                    </tr>
                    <tr><td style="padding:6px 10px;">Scripted event at fixed time – scored on <em>response</em>, not prevention</td>
                        <td style="text-align:center;"><input type="radio" name="r3" value="yes" /></td>
                        <td style="text-align:center;"><input type="radio" name="r3" value="no" /></td>
                        <td style="text-align:center;"><input type="radio" name="r3" value="unsure" /></td>
                    </tr>
                    <tr><td style="padding:6px 10px;">Prelims: one judge per domain, no averaging</td>
                        <td style="text-align:center;"><input type="radio" name="r4" value="yes" /></td>
                        <td style="text-align:center;"><input type="radio" name="r4" value="no" /></td>
                        <td style="text-align:center;"><input type="radio" name="r4" value="unsure" /></td>
                    </tr>
                    <tr><td style="padding:6px 10px;">Semis: two judges per domain, marks <strong>averaged</strong> (not summed)</td>
                        <td style="text-align:center;"><input type="radio" name="r5" value="yes" /></td>
                        <td style="text-align:center;"><input type="radio" name="r5" value="no" /></td>
                        <td style="text-align:center;"><input type="radio" name="r5" value="unsure" /></td>
                    </tr>
                    <tr><td style="padding:6px 10px;">Domain I = clinical recognition; Domain II = <em>process</em> (not diagnosis)</td>
                        <td style="text-align:center;"><input type="radio" name="r6" value="yes" /></td>
                        <td style="text-align:center;"><input type="radio" name="r6" value="no" /></td>
                        <td style="text-align:center;"><input type="radio" name="r6" value="unsure" /></td>
                    </tr>
                    <tr><td style="padding:6px 10px;">Safety flags inform debrief/advancement – don't auto‑change marks</td>
                        <td style="text-align:center;"><input type="radio" name="r7" value="yes" /></td>
                        <td style="text-align:center;"><input type="radio" name="r7" value="no" /></td>
                        <td style="text-align:center;"><input type="radio" name="r7" value="unsure" /></td>
                    </tr>
                    <tr><td style="padding:6px 10px;">Confederate nurses will be present to assist and standardise flow</td>
                        <td style="text-align:center;"><input type="radio" name="r8" value="yes" /></td>
                        <td style="text-align:center;"><input type="radio" name="r8" value="no" /></td>
                        <td style="text-align:center;"><input type="radio" name="r8" value="unsure" /></td>
                    </tr>
                    <tr><td style="padding:6px 10px;">Live audience &amp; live video display projected on screen</td>
                        <td style="text-align:center;"><input type="radio" name="r9" value="yes" /></td>
                        <td style="text-align:center;"><input type="radio" name="r9" value="no" /></td>
                        <td style="text-align:center;"><input type="radio" name="r9" value="unsure" /></td>
                    </tr>
                    <tr><td style="padding:6px 10px;">Tiebreaker: team leader only, 60 sec, no conferring</td>
                        <td style="text-align:center;"><input type="radio" name="r10" value="yes" /></td>
                        <td style="text-align:center;"><input type="radio" name="r10" value="no" /></td>
                        <td style="text-align:center;"><input type="radio" name="r10" value="unsure" /></td>
                    </tr>
                    <tr><td style="padding:6px 10px;">Semis: manage <strong>two</strong> patients simultaneously</td>
                        <td style="text-align:center;"><input type="radio" name="r11" value="yes" /></td>
                        <td style="text-align:center;"><input type="radio" name="r11" value="no" /></td>
                        <td style="text-align:center;"><input type="radio" name="r11" value="unsure" /></td>
                    </tr>
                    <tr><td style="padding:6px 10px;">Finals: Clinical Management + Teamwork &amp; Followership + Shared Reasoning</td>
                        <td style="text-align:center;"><input type="radio" name="r12" value="yes" /></td>
                        <td style="text-align:center;"><input type="radio" name="r12" value="no" /></td>
                        <td style="text-align:center;"><input type="radio" name="r12" value="unsure" /></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="form-group">
        <label>A3. Is there any aspect of the format, rules, or scoring you are particularly confused or worried about?</label>
        <textarea rows="3"></textarea>
    </div>

    <!-- SECTION B -->
    <div class="section-title">B. Debriefing Awareness &amp; Comfort</div>

    <div class="form-group">
        <label>B1. Are you familiar with the "positive‑only" public debrief concept?</label>
        <select>
            <option value="">– Please select –</option>
            <option>Yes, I understand</option>
            <option>I have heard of it but am not clear</option>
            <option>No, this is new to me</option>
        </select>
    </div>

    <div class="form-group">
        <label>B2. How comfortable are you receiving feedback—especially constructive—in front of an audience?</label>
        <div class="inline-radio">
            <label><input type="radio" name="b2" value="1" /> 1 – Very uncomfortable</label>
            <label><input type="radio" name="b2" value="2" /> 2</label>
            <label><input type="radio" name="b2" value="3" /> 3</label>
            <label><input type="radio" name="b2" value="4" /> 4</label>
            <label><input type="radio" name="b2" value="5" /> 5 – Very comfortable</label>
        </div>
    </div>

    <div class="form-group">
        <label>B3. What makes a debriefing session MOST valuable to you? <span class="optional">(select up to 2)</span></label>
        <div class="checkbox-group">
            <label><input type="checkbox" /> Constructive, specific feedback on improvement</label>
            <label><input type="checkbox" /> Positive reinforcement on what I did well</label>
            <label><input type="checkbox" /> Time to reflect on my own performance</label>
            <label><input type="checkbox" /> Hearing perspectives of other team members</label>
            <label><input type="checkbox" /> Structured framework (e.g., advocacy-inquiry)</label>
            <label><input type="checkbox" /> Written/verbal feedback from facilitator</label>
            <label><input type="checkbox" /> Other: <input type="text" style="width:auto;display:inline;padding:4px 8px;border-radius:6px;" placeholder="specify" /></label>
        </div>
    </div>

    <!-- SECTION C -->
    <div class="section-title">C. Competition‑Specific Anxieties &amp; Support</div>

    <div class="form-group">
        <label>C1. How anxious or stressed do you feel about SimWars?</label>
        <div class="inline-radio">
            <label><input type="radio" name="c1" value="1" /> 1 – Not at all (looking forward)</label>
            <label><input type="radio" name="c1" value="2" /> 2</label>
            <label><input type="radio" name="c1" value="3" /> 3</label>
            <label><input type="radio" name="c1" value="4" /> 4</label>
            <label><input type="radio" name="c1" value="5" /> 5 – Extremely (worried)</label>
        </div>
    </div>

    <div class="form-group">
        <label>C2. Which aspects of the <em>competition itself</em> do you find MOST anxiety‑provoking? <span class="optional">(select all that apply)</span></label>
        <div class="checkbox-group">
            <label><input type="checkbox" /> Being observed by judges/live audience</label>
            <label><input type="checkbox" /> Performing skills under time pressure</label>
            <label><input type="checkbox" /> Making a mistake in front of peers</label>
            <label><input type="checkbox" /> Speaking up / challenging a senior in this setting</label>
            <label><input type="checkbox" /> Managing two patients simultaneously</label>
            <label><input type="checkbox" /> The public debriefing process</label>
            <label><input type="checkbox" /> Not knowing what to expect (scripted events)</label>
            <label><input type="checkbox" /> The tiebreaker process</label>
            <label><input type="checkbox" /> Other: <input type="text" style="width:auto;display:inline;padding:4px 8px;border-radius:6px;" placeholder="specify" /></label>
        </div>
    </div>

    <div class="form-group">
        <label>C3. Do you have any specific concerns about the live audience or video recording?</label>
        <textarea rows="2"></textarea>
    </div>

    <div class="form-group">
        <label>C4. Is there anything the organising team can do to make your <em>competition experience</em> more comfortable?</label>
        <textarea rows="2"></textarea>
    </div>

    <hr />

    <!-- ============================================================ -->
    <!-- PART 2 – CLINICAL KAP                                          -->
    <!-- ============================================================ -->

    <div class="part-divider">Part 2 <small>Clinical Knowledge, Attitude &amp; Practice (KAP)</small></div>

    <!-- SECTION 1 -->
    <div class="section-title">1. Demographics &amp; Professional Background</div>

    <div class="form-group">
        <label>1.1 Email Address <span class="optional">(for confirmation)</span></label>
        <input type="email" placeholder="you@hospital.org" />
    </div>

    <div class="grid-2col">
        <div class="form-group">
            <label>1.2 Primary professional role</label>
            <select id="professionalRole" onchange="updateRoleSections()">
                <option value="">– Please select –</option>
                <option value="nurse">Registered Nurse / Nurse Practitioner</option>
                <option value="resident">Paediatric Resident (PGY1‑3 / Senior)</option>
                <option value="fellow">PICU Fellow / DM / DNB Trainee</option>
                <option value="attending">Attending Physician / Consultant</option>
                <option value="other">Other (Allied Health, Student, Paramedic, etc.)</option>
            </select>
        </div>
        <div class="form-group">
            <label>1.3 Current designation / grade</label>
            <select>
                <option value="">– Please select –</option>
                <option>Intern / Foundation Year</option>
                <option>Junior Resident (PGY1‑3)</option>
                <option>Senior Resident</option>
                <option>Fellow / Registrar</option>
                <option>Attending / Consultant</option>
                <option>Staff Nurse / Registered Nurse</option>
                <option>Senior Staff Nurse / Charge Nurse</option>
                <option>Nurse Educator / Clinical Instructor</option>
                <option>EMT/CCT</option>
                <option>Other</option>
            </select>
        </div>
    </div>

    <div class="grid-2col">
        <div class="form-group">
            <label>1.4 Years of clinical experience <span class="optional">(post‑qualification)</span></label>
            <select>
                <option value="">– Please select –</option>
                <option>&lt;1 year</option>
                <option>1‑2 years</option>
                <option>3‑5 years</option>
                <option>6‑10 years</option>
                <option>&gt;10 years</option>
            </select>
        </div>
        <div class="form-group">
            <label>1.5 Primary clinical setting</label>
            <select>
                <option value="">– Please select –</option>
                <option>Paediatric Emergency Department</option>
                <option>Paediatric Intensive Care Unit</option>
                <option>Neonatal Intensive Care Unit</option>
                <option>Paediatric Ward / General Paediatrics</option>
                <option>Operating Theatre / Anaesthesia</option>
                <option>Mixed / Rotation‑based</option>
                <option>Other</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label>1.6 Paediatric resuscitation courses completed <span class="optional">(select all that apply)</span></label>
        <div class="checkbox-group">
            <label><input type="checkbox" /> None</label>
